---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Publication from '../components/Publication.astro';
import { local } from '../lib/urls';
const home = await getEntry('pages', 'home');
const { Content } = await render(home!);
const research = (await getCollection('research')).sort((a,b) => a.data.order-b.data.order);
const pubs = (await getCollection('publications')).sort((a,b) => a.data.order-b.data.order).slice(0, 2);
const news = await Promise.all((await getCollection('news', ({ data }) => !data.draft)).sort((a,b) => b.data.date.getTime()-a.data.date.getTime()).map(async entry => ({...entry, ...await render(entry)})));
---
<Layout title="Protein Control and Organization" description={home!.data.description}>
  <section class="hero wrap">
    <div class="hero-frame">
      <picture class="hero-art" aria-hidden="true">
        <source media="(max-width: 760px)" srcset={local('/images/hero-proximity-mobile.webp')} width="1000" height="1000" />
        <img src={local('/images/hero-proximity-desktop.webp')} width="2400" height="780" alt="" fetchpriority="high" decoding="async" />
      </picture>
      <div class="hero-identity">
        <p class="eyebrow">{home!.data.eyebrow}</p>
        <h1>{home!.data.title}</h1>
        <p class="hero-subtitle">{home!.data.subtitle}</p>
      </div>
    </div>
  </section>
  <section class="mission-section wrap" aria-labelledby="mission-title">
    <figure class="microscopy"><a class="image-link" href={local('/research/')}><Photo src="/images/proteome-tagging.webp" alt="Grayscale microscopy showing cells with varied protein localization following proteome-scale tagging" width={1521} height={1138} eager /></a><figcaption>Proteome-scale tagging and manipulation.<br />Functional genomics. Optical pooled screening.</figcaption></figure>
    <div class="mission-copy"><h2 id="mission-title">A single-cell,<br />proteome-wide lens:</h2><div class="prose mission-statements"><Content /></div><a class="text-link" href={local('/research/')}>Learn more about our science <span aria-hidden="true">→</span></a></div>
  </section>
  <section class="research-overview section-tint" aria-labelledby="research-title"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">Questions that drive us</p><h2 id="research-title">Our research</h2></div><a class="text-link" href={local('/research/')}>Explore the projects →</a></div>
    <div class="research-index">{research.map((entry,i) => <a href={local(`/research/#${entry.id}`)}><span class="index-number">0{i+1}</span><h3>{entry.data.title}</h3><span class="index-arrow" aria-hidden="true">↗</span></a>)}</div>
  </div></section>
  <section class="wrap section-spacing" aria-labelledby="selected-title"><div class="section-heading"><div><p class="eyebrow">From the lab</p><h2 id="selected-title">Selected publications</h2></div><a class="text-link" href={local('/publications/')}>All selected publications →</a></div>{pubs.map(entry => <Publication entry={entry} />)}</section>
  {news.length > 0 && <section class="wrap section-spacing news" aria-labelledby="news-title"><p class="eyebrow">Lab updates</p><h2 id="news-title">News</h2>{news.map(({data,Content}) => <article><time datetime={data.date.toISOString()}>{data.date.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time><h3>{data.title}</h3><div class="prose"><Content /></div></article>)}</section>}
  <section class="lab-life wrap" aria-labelledby="life-title"><a class="lab-life-image image-link" href={local('/photos/')} aria-label="See photos of life outside the lab"><Photo src="/images/photos/cheesequake-park-2.webp" alt="Serebrenik Lab members posing together at Cheesequake Park" /></a><div><p class="eyebrow">Science is a team effort</p><h2 id="life-title">Meet the people.<br />See life outside the lab.</h2><div class="life-links"><a class="text-link" href={local('/team/')}>Our team →</a><a class="text-link" href={local('/photos/')}>Lab photos →</a></div></div></section>
</Layout>
