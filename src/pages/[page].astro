---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Publication from '../components/Publication.astro';
import site from '../../content/site.json';
import { local } from '../lib/urls';
export function getStaticPaths() { return ['research','team','photos','publications','support','contact'].map(page => ({params:{page}})); }
const { page } = Astro.params;
const entry = await getEntry('pages', page!);
const { Content } = await render(entry!);
const research = page === 'research' ? await Promise.all((await getCollection('research')).sort((a,b)=>a.data.order-b.data.order).map(async e=>({...e,...await render(e)}))) : [];
const people = page === 'team' ? await Promise.all((await getCollection('people')).sort((a,b)=>a.data.order-b.data.order).map(async e=>({...e,...await render(e)}))) : [];
const alumni = page === 'team' ? await Promise.all((await getCollection('alumni')).sort((a,b)=>a.data.order-b.data.order).map(async e=>({...e,...await render(e)}))) : [];
const photos = page === 'photos' ? await Promise.all((await getCollection('photos')).sort((a,b)=>a.data.order-b.data.order).map(async e=>({...e,...await render(e)}))) : [];
const pubs = page === 'publications' ? (await getCollection('publications')).sort((a,b)=>a.data.order-b.data.order) : [];
---
<Layout title={entry!.data.title} description={entry!.data.description}>
  <header class="page-heading wrap"><p class="eyebrow">{entry!.data.eyebrow}</p><h1>{entry!.data.title}</h1>{page !== 'contact' && <div class="prose page-intro"><Content /></div>}</header>
  {page === 'research' && <div class="wrap research-page"><nav class="project-nav" aria-label="Research projects">{research.map((e,i) => <a href={`#${e.id}`}><span>0{i+1}</span>{e.data.title}</a>)}</nav><div class="project-list">{research.map(({id,data,Content},i) => <article id={id} class="project"><p class="eyebrow">Research direction / 0{i+1}</p><h2>{data.title}</h2><ul class="research-questions">{data.questions.map(q=><li>{q}</li>)}</ul><div class="prose"><Content /></div>{data.figures.map(figure => <figure class="research-figure"><Photo src={figure.src} alt={figure.alt} width={figure.width} height={figure.height} sizes="(max-width: 760px) 100vw, 750px" />{figure.caption && <figcaption>{figure.caption}</figcaption>}</figure>)}</article>)}</div></div>}
  {page === 'team' && <div class:list={['wrap','people',{'has-alumni':alumni.length>0}]}>{people.map(({data,Content},i)=><article class:list={['person',{'person-lead':i===0}]}><div class="portrait"><Photo src={data.image} alt={data.alt} width={700} height={700} eager={i===0} sizes="(max-width: 700px) 100vw, 33vw" /></div><div class="person-copy"><p class="eyebrow">{data.role}</p><h2>{data.name}</h2><div class="prose"><Content /></div></div></article>)}</div>}
  {page === 'team' && alumni.length > 0 && <section class="wrap alumni" aria-labelledby="alumni-title"><h2 id="alumni-title">Alumni</h2><div class="alumni-list">{alumni.map(({data,Content}) => <article class="alumnus"><Photo class="alumni-portrait" src={data.image} alt={data.alt} sizes="(max-width: 760px) 72px, 88px" /><div><h3>{data.name}</h3><p class="alumni-role">{data.role}</p><div class="prose"><Content /></div></div></article>)}</div></section>}
  {page === 'photos' && <div class="wrap photo-albums">{photos.map(({data,Content})=><section class="album"><div class="album-heading"><h2>{data.title}</h2><div class="prose"><Content /></div></div><div class:list={['photo-grid',{'photo-pair':data.images.length>1}]}>{data.images.map((img,i)=><a href={local(img.src)} aria-label={`Open full image: ${img.alt}`}><Photo src={img.src} alt={img.alt} eager={data.order===1 && i===0} sizes={data.images.length>1 ? '(max-width: 700px) 100vw, 50vw' : '100vw'} /><span class="photo-expand" aria-hidden="true">↗</span></a>)}</div></section>)}</div>}
  {page === 'publications' && <div class="wrap publications-page"><a class="button bibliography" href={site.bibliography}>Complete publication list <span aria-hidden="true">↗</span></a><div>{pubs.map(e=><Publication entry={e}/>)}</div></div>}
  {page === 'support' && <div class="wrap supporters">{entry!.data.supporters.map((supporter,i) => <article><div class="supporter-logo"><Photo src={supporter.image} alt={supporter.alt} eager={i===0} width={supporter.width} height={supporter.height} /></div><div><p class="eyebrow">{supporter.category}</p><h2>{supporter.name}</h2><a class="text-link" href={supporter.url}>{supporter.linkText} ↗</a></div></article>)}</div>}
  {page === 'contact' && <section class="wrap contact-grid"><div><div class="contact-email"><div class="prose"><Content /></div><a href={`mailto:${site.email}`}>{site.email}</a></div><h2>Visit the lab</h2><address>{site.department}<br/>{site.building}<br/>{site.street}<br/>{site.city}<p>{site.rooms}</p></address><a class="text-link" href={site.map}>Directions on Google Maps ↗</a><div class="contact-social"><p class="eyebrow">Visit us on</p><a href={site.bluesky}>Bluesky ↗</a><a href={site.x}>X ↗</a></div></div><a class="contact-map" href={site.map} aria-label="View the lab location on Google Maps"><Photo src="/images/contact-map.webp" alt="Regional map showing the lab location in Piscataway, New Jersey" width={572} height={572} eager/><span>683 Hoes Ln W · Piscataway, NJ <span aria-hidden="true">↗</span></span></a></section>}
</Layout>
