---
import '../styles/global.css';
import site from '../../content/site.json';
import { local } from '../lib/urls';
const { title, description, canonicalPath, noindex = false } = Astro.props;
const canonical = new URL(canonicalPath || Astro.url.pathname, Astro.site);
const nav = [['Research','research'],['Team','team'],['Photos','photos'],['Publications','publications'],['Support','support'],['Contact','contact']];
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/\/$/, '');
const schema = { '@context': 'https://schema.org', '@type': 'ResearchOrganization', name: site.name, url: new URL(local('/'), Astro.site).href, email: site.email, parentOrganization: { '@type': 'CollegeOrUniversity', name: site.university }, address: { '@type': 'PostalAddress', streetAddress: site.street, addressLocality: 'Piscataway', addressRegion: 'NJ', postalCode: '08854', addressCountry: 'US' }, sameAs: [site.x, site.bluesky] };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === site.name ? title : `${title} — ${site.name}`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#174f4d" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href={local('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(local('/images/proteome-tagging.webp'), Astro.site)} />
    <meta property="og:image:alt" content="Microscopy of proteome-scale protein tagging" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="brand" href={local('/')} aria-label="Serebrenik Lab home">{site.name}</a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="navigation" hidden><span>Menu</span><span class="menu-icon" aria-hidden="true">☰</span></button>
        <nav id="navigation" aria-label="Main navigation">
          {nav.map(([label, path]) => <a href={local(`/${path}/`)} aria-current={current === path ? 'page' : undefined}>{label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-main wrap">
        <div><a class="brand footer-brand" href={local('/')}>{site.name}</a><p>Protein Control<br />and Organization</p></div>
        <address><strong>{site.department}</strong><br />{site.building}<br />{site.street}<br />{site.city}<p>{site.rooms}</p></address>
        <div class="footer-connect"><span class="eyebrow">Connect with us</span><a class="email" href={`mailto:${site.email}`}>{site.email}</a><div class="social"><a href={site.bluesky}>Bluesky ↗</a><a href={site.x}>X ↗</a><a href={local('/contact/')}>Visit the lab →</a></div></div>
      </div>
      <div class="footer-bottom wrap"><span>© {new Date().getUTCFullYear()} {site.name}</span><span>Rutgers University · Piscataway, NJ</span><a href={local('/support/')}>Research support</a></div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#navigation');
      if (button && nav) {
        button.hidden = false;
        document.documentElement.classList.add('has-js');
        const close = () => { button.setAttribute('aria-expanded', 'false'); nav.classList.remove('is-open'); };
        button.addEventListener('click', () => {
          const expanded = button.getAttribute('aria-expanded') !== 'true';
          button.setAttribute('aria-expanded', String(expanded)); nav.classList.toggle('is-open', expanded);
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') { close(); button.focus(); } });
        nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
        document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.header-inner')) close(); });
      }
    </script>
  </body>
</html>
